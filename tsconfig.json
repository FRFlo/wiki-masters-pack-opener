{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"skipLibCheck": true,
		"types": ["bun"]
	},
	"include": [
		"src/**/*.ts",
		"commands/**/*.ts",
		"buttons/**/*.ts",
		"events/**/*.ts",
		"handlers/**/*.ts",
		"services/**/*.ts",
		"types.ts",
		"config.ts"
	]
}
