# Identifiants de l'application Discord
DISCORD_TOKEN=replace-with-bot-token
DISCORD_CLIENT_ID=replace-with-application-id
# Optional: keeps instant guild command registration while global commands update.
DISCORD_GUILD_ID=replace-with-server-id

# Le cookie est désormais configuré par /compte connecter dans Discord.
# COOKIE n'est plus nécessaire au démarrage.

# Fréquence de vérification des modules automatiques (3 minutes)
SCHEDULER_INTERVAL_MS=180000

# Fréquence de synchronisation du catalogue pour l'autocomplete (15 minutes)
CATALOG_SYNC_INTERVAL_MS=900000
